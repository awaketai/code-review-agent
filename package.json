{
  "name": "code-review-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "LLM-driven code review agent built on simple-agent",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "code-review": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "simple-agent": "file:../simple-agent"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
